{
  "name": "shanti-vikasa-register",
  "version": "1.0.3",
  "private": true,
  "description": "Shanti Vikasa offline Windows register with secure online synchronization",
  "main": "desktop/main.cjs",
  "scripts": {
    "build": "npm run build:vercel",
    "test": "node --test tests/*.test.cjs",
    "start": "electron .",
    "build:desktop": "vite build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "login:setup": "node scripts/create-login.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "vite --config vite.qa.config.ts --host 0.0.0.0 --port 4173",
    "build:vercel": "npm run build:desktop && node scripts/deploy-migrate.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.17.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "^0.45.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.31.0",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electron/asar": "4.0.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "drizzle-kit": "^0.31.8",
    "electron": "44.2.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "engines": {
    "node": "24.x"
  }
}
